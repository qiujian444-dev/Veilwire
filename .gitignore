# ---------------------------------------------------------------------------
# 隐私红线：以下内容永不入库
# 这个目录存的是本地工作记录（含服务器地址、运维细节、账号线索）。
# 开源仓库里出现任何个人/基础设施信息都算泄露，加规则比靠人记靠谱。
# ---------------------------------------------------------------------------
/.workbuddy/
/claude/

# ---------------------------------------------------------------------------
# 构建产物与大文件
# ---------------------------------------------------------------------------
# Rust
/rust/target/
**/*.rs.bk

# Android
/android/**/build/
/android/**/.gradle/
/android/**/local.properties
/android/**/.idea/
/android/**/.cxx/
/android/**/captures/
*.apk
*.aab
*.iml

# 交叉编译出来的 .so 由 scripts/build-android.sh 生成，不进版本库
/android/app/app/src/main/jniLibs/**/*.so

# 发布产物
/dist/

# 本地构建工作目录（脚本在 ASCII 路径下编译用）
/c-rs-stage0/
/c-anonchat-build/
/c/anonchat-build/

# ---------------------------------------------------------------------------
# 可能含个人信息的素材
# 截图里会出现真实联系人、聊天内容、邀请码、中继地址；需要的话用脱敏后的截图替换
# ---------------------------------------------------------------------------
/docs/assets/*.png
/docs/assets/*.jpg

# ---------------------------------------------------------------------------
# 凭证 / 证书
# 签名密钥放在 ./keys/（含 CREDENTIALS.txt），整个目录连文件一起忽略，
# 避免只挡 *.jks 却把写着密码的说明文件漏进去
# ---------------------------------------------------------------------------
/keys/
*.jks
*.keystore
*.p12
*.pem
*.key

# 日志
*.log
/relay-data/

# OS
.DS_Store
Thumbs.db
