<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 前台服务：类型必须与代码里 startForeground 传的常量一致 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <!-- 通话期间后台采集：Android 11+ 的 while-in-use 限制会在 Activity 不可见
         且无对应类型 FGS 时把麦克风送达静音、相机停帧（通话切后台=单方面听不见） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <!-- Android 13+ 运行时申请，否则前台服务通知不显示 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Doze 白名单：息屏后还能收消息的前提 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 语音/视频通话 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 通话中要改音频路由（听筒/扬声器），Android 12+ 需要显式声明 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- 来电时把通话界面直接顶上来（电话类应用的标准通道） -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 通话期间保持屏幕 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 没有麦克风的设备也能装（只能接对方的视频），但通话功能会不可用 -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.AnonChat">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 扫码：库自带的 CaptureActivity 是 sensorLandscape + 全屏无标题栏（一个退出按钮都没有），
             所以换成我们自己的子类：锁竖屏 + 左上角 ✕。详见 QrScanActivity 的注释 -->
        <activity
            android:name=".QrScanActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:theme="@style/zxing_CaptureTheme"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <!--
            关键：remoteMessaging。
            绝对不要改成 dataSync —— Android 15 起该类型 24 小时内累计只能跑 6 小时，
            超时抛 RemoteServiceException 直接崩溃。
            microphone / camera 必须在这里一起声明：通话期间 setForegroundServiceType
            只能做已声明类型的子集，否则抛 IllegalStateException、类型升级静默失败，
            后台通话就失去了 while-in-use 权限豁免。
        -->
        <service
            android:name=".MessagingService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging|microphone|camera" />

        <!-- 已接收文件的开箱通道：气泡点按 → FileProvider URI → 系统查看器 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Doze 逃生舱：进程被杀后由精确闹钟拉回（见 KeepaliveReceiver 注释） -->
        <receiver
            android:name=".KeepaliveReceiver"
            android:exported="false" />

        <!-- 来电通知上的接听/拒接按钮（CallStyle.forIncomingCall 需要） -->
        <receiver
            android:name=".CallActionReceiver"
            android:exported="false" />

    </application>
</manifest>
