<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 前台服务：类型必须与代码里 startForeground 传的位掩码一致 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />

    <!-- Android 13+ 必须运行时申请，否则前台服务通知不显示 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 开机自启（Android 15 对 BOOT_COMPLETED 启动 FGS 的限制只针对 dataSync） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Doze 白名单：这是本方案能在息屏后收消息的前提 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="Stage0 保活验证"
        android:supportsRtl="true"
        android:theme="@style/Theme.Stage0">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            关键点：foregroundServiceType 用 remoteMessaging。
            绝对不要用 dataSync —— Android 15 起该类型 24 小时内累计只能跑 6 小时，
            超时抛 RemoteServiceException 直接崩溃。
        -->
        <service
            android:name=".MessagingService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
